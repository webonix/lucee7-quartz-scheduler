{
  "jobs": [
    {
      "label": "Example for every 12 seconds",
      "component": "quartz.checkPurpose",
      "interval": "12",
      "pause": false
    }
  ],
  "listeners": [
    {
      "stream": "err",
      "component": "systemoutputListener"
    }
  ],
  "store": {
    "type": "redis",
    "host": "redis",
    "port": 6379,
    "password": "strongpassword",
    "misfireThreshold": 60000,
    "database": 0,
    "keyPrefix": "quartz",
    "lockTimeout": 50000
  }
}