{
  "jobs": [
    {
      "label": "every 15 seconds every day",
      "url": "/cron/systemoutput.cfm",
      "cron": "0/15 * * ? * *",
      "pause": false
    }
  ],
  "listeners": [

  ],
  "store": {
    "type": "redis",
    "host": "redis",
    "port": 6379,
    "password": "strongpassword",
    "database": 0,
    "keyPrefix": "quartz"
  }
}